/* ================================================
   登录/个人中心 - 暖米色主题 (Warm Cream)
   ================================================ */

.login-page {
  min-height: 100vh;
  background: linear-gradient(170deg, #fbf4e6 0%, #fef7ed 40%, #fdf3e4 100%);
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.login-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  pointer-events: none;
  overflow: hidden;
}

.login-bg-circle {
  position: absolute;
  border-radius: 50%;
}

.login-bg-circle--1 {
  width: 420rpx; height: 420rpx;
  top: -140rpx; right: -100rpx;
  background: radial-gradient(circle, rgba(226,165,80,0.12) 0%, transparent 70%);
}

.login-bg-circle--2 {
  width: 320rpx; height: 320rpx;
  bottom: 10%; left: -120rpx;
  background: radial-gradient(circle, rgba(226,165,80,0.07) 0%, transparent 70%);
}

/* 主容器 */
.login-container {
  position: relative;
  z-index: 1;
  padding: 100rpx 36rpx 60rpx;
}

/* ================================================
   品牌区域
   ================================================ */
.login-brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 56rpx;
}

.login-brand-logo {
  margin-bottom: 20rpx;
}

.login-brand-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 32rpx;
  box-shadow: 0 14rpx 44rpx rgba(226,166,80,0.28);
}

.login-brand-tagline {
  font-size: 26rpx;
  color: var(--muted, #7a6a58);
  letter-spacing: 1rpx;
}

/* ================================================
   已登录 - 用户卡片
   ================================================ */
.login-section {
  animation: loginFadeIn 0.4s ease-out;
}

@keyframes loginFadeIn {
  from { opacity: 0; transform: translateY(16rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.login-user-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--surface, #fffdf8);
  border: 1rpx solid var(--border, rgba(90,60,30,0.1));
  border-radius: 28rpx;
  padding: 48rpx 40rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow, 0 14rpx 34rpx rgba(125,90,50,0.1));
}

.login-avatar-area {
  position: relative;
  margin-bottom: 24rpx;
}

.login-avatar-img {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary, #e2a650);
  box-shadow: 0 8rpx 28rpx rgba(226,166,80,0.22);
}

.login-avatar-badge {
  position: absolute;
  right: 4rpx;
  bottom: 4rpx;
  width: 48rpx;
  height: 48rpx;
  background: var(--primary, #e2a650);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 14rpx rgba(226,166,80,0.3);
}

.login-avatar-badge image {
  width: 24rpx;
  height: 24rpx;
}

.login-user-body {
  text-align: center;
}

.login-user-name {
  font-size: 38rpx;
  font-weight: 700;
  color: var(--text-strong, #2d241b);
  margin-bottom: 12rpx;
}

.login-user-meta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.login-user-tag {
  font-size: 22rpx;
  color: var(--muted, #7a6a58);
  background: var(--surface-2, #f6e8d6);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.login-user-online {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: #4faa6a;
  background: rgba(79,170,106,0.08);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.login-user-dot {
  width: 10rpx;
  height: 10rpx;
  background: #4faa6a;
  border-radius: 50%;
}

.login-user-bio {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--muted, #7a6a58);
  line-height: 1.5;
  padding: 0 16rpx;
}

/* 性别 */
.login-gender-row {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.login-gender-tag {
  padding: 8rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--surface-2, #f6e8d6);
  color: var(--text, #4a3b2a);
}

.login-gender--male {
  background: rgba(0,122,255,0.08);
  color: #007aff;
}

.login-gender--female {
  background: rgba(255,45,85,0.08);
  color: #ff2d55;
}

/* ================================================
   已登录 - 功能菜单
   ================================================ */
.login-menu {
  background: var(--surface, #fffdf8);
  border: 1rpx solid var(--border, rgba(90,60,30,0.1));
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow, 0 14rpx 34rpx rgba(125,90,50,0.1));
}

.login-menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 32rpx;
  transition: background-color 0.15s;
}

.login-menu-item--hover {
  background: var(--surface-2, #f6e8d6);
}

.login-menu-item-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.login-menu-item-icon image {
  width: 30rpx;
  height: 30rpx;
}

.login-menu-item-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text, #4a3b2a);
  font-weight: 500;
}

.login-menu-item-text--danger {
  color: var(--accent, #d46a4c);
}

.login-menu-item-arrow {
  font-size: 36rpx;
  color: var(--muted, #7a6a58);
  opacity: 0.35;
  font-weight: 300;
}

.login-menu-divider {
  height: 1rpx;
  background: var(--border, rgba(90,60,30,0.08));
  margin: 0 32rpx;
}

/* ================================================
   未登录 - 登录卡片
   ================================================ */
.login-sheet {
  background: var(--surface, #fffdf8);
  border: 1rpx solid var(--border, rgba(90,60,30,0.1));
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: var(--shadow, 0 14rpx 34rpx rgba(125,90,50,0.1));
  animation: loginSlideUp 0.4s ease-out;
}

@keyframes loginSlideUp {
  from { opacity: 0; transform: translateY(24rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.login-btn-wechat {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  border: none;
  background: linear-gradient(180deg, #07c160 0%, #06ae56 100%);
  box-shadow: 0 8rpx 28rpx rgba(7,193,96,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  margin: 0;
  padding: 0;
}

.login-btn-wechat::after {
  border: none;
}

.login-btn-wechat--locked {
  opacity: 0.45;
  box-shadow: none;
}

.login-btn-wechat:active:not(.login-btn-wechat--locked) {
  transform: scale(0.98);
  opacity: 0.94;
}

.login-btn-wechat-icon {
  width: 42rpx;
  height: 42rpx;
  flex-shrink: 0;
}

/* 协议 */
.login-agreement {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding-top: 28rpx;
  padding-left: 52rpx;
}

.login-agreement-check {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  margin-top: 4rpx;
}

.login-agreement-check image {
  width: 34rpx;
  height: 34rpx;
}

.login-agreement-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--muted, #7a6a58);
}

.login-agreement-gray {
  color: var(--muted, #7a6a58);
}

.login-agreement-link {
  color: #2c6ecb;
}

/* ================================================
   弹窗
   ================================================ */
.login-modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 1000;
  background: rgba(0,0,0,0.45);
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal {
  width: 640rpx;
  max-height: 88vh;
  background: var(--surface, #fffdf8);
  border-radius: 28rpx;
  overflow: hidden;
  animation: loginModalIn 0.28s ease-out;
}

@keyframes loginModalIn {
  from { opacity: 0; transform: scale(0.92); }
  to   { opacity: 1; transform: scale(1); }
}

.login-modal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 36rpx 20rpx;
}

.login-modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-strong, #2d241b);
}

.login-modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--muted, #7a6a58);
  opacity: 0.4;
}

.login-modal-body {
  padding: 8rpx 36rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 26rpx;
  max-height: 62vh;
  overflow-y: auto;
}

.login-modal-foot {
  display: flex;
  padding: 16rpx 36rpx 36rpx;
  gap: 20rpx;
}

.login-modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.login-modal-btn--cancel {
  background: var(--surface-2, #f6e8d6);
  color: var(--text, #4a3b2a);
}

.login-modal-btn--cancel:active {
  opacity: 0.8;
}

.login-modal-btn--confirm {
  background: linear-gradient(135deg, #e2a650, #c7862d);
  color: #fff;
  box-shadow: 0 6rpx 20rpx rgba(226,166,80,0.35);
}

.login-modal-btn--confirm:active {
  transform: scale(0.97);
}

/* ================================================
   弹窗表单
   ================================================ */
.login-form-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 4rpx;
}

.login-form-avatar-wrap {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}

.login-form-avatar-img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary, #e2a650);
}

.login-form-avatar-badge {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 40rpx;
  height: 40rpx;
  background: var(--primary, #e2a650);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  box-shadow: 0 3rpx 10rpx rgba(226,166,80,0.3);
}

.login-form-avatar-badge image {
  width: 22rpx;
  height: 22rpx;
}

.login-form-avatar-tip {
  font-size: 22rpx;
  color: var(--muted, #7a6a58);
}

.login-form-field {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.login-form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-strong, #2d241b);
}

.login-form-input {
  width: 100%;
  height: 88rpx;
  background: var(--app-bg, #fbf4e6);
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: var(--text, #4a3b2a);
  box-sizing: border-box;
}

.login-form-gender {
  display: flex;
  gap: 14rpx;
}

.login-form-gender-btn {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--app-bg, #fbf4e6);
  color: var(--muted, #7a6a58);
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.login-form-gender--on {
  background: var(--primary, #e2a650);
  color: #fff;
}

.login-form-textarea {
  width: 100%;
  min-height: 140rpx;
  background: var(--app-bg, #fbf4e6);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: var(--text, #4a3b2a);
  box-sizing: border-box;
  line-height: 1.5;
}

.login-form-counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--muted, #7a6a58);
  opacity: 0.5;
}
