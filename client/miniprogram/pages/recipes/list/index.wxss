.page {
  min-height: 100vh;
  background-color: #fbf4e6;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.sort-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  background: #fffdf8;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(125, 90, 50, 0.05);
}

.sort-btn {
  font-size: 28rpx;
  color: #8e8e93;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #f6e8d6;
  transition: all 0.2s;
}

.sort-btn.active {
  background: #e2a650;
  color: #fff;
  font-weight: 600;
}

.list-scroll {
  flex: 1;
  min-height: 0;
}

.list-content {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.recipe-card {
  background: #fffdf8;
  border-radius: 24rpx;
  overflow: hidden;
  display: flex;
  flex-direction: row;
  box-shadow: 0 4rpx 16rpx rgba(125, 90, 50, 0.07);
}

.recipe-cover {
  width: 220rpx;
  height: 200rpx;
  flex-shrink: 0;
}

.recipe-info {
  flex: 1;
  min-width: 0;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.recipe-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-desc {
  font-size: 24rpx;
  color: #8e8e93;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 12rpx;
}

.recipe-tags {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}

.tag {
  background: #f6e8d6;
  color: #92400e;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.tag-diff-easy {
  background: #dcfce7;
  color: #166534;
}

.tag-diff-hard {
  background: #fee2e2;
  color: #991b1b;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 40rpx 0;
}

.loading-ring-sm {
  width: 40rpx;
  height: 40rpx;
  border: 3rpx solid #e2a650;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text-sm {
  font-size: 26rpx;
  color: #8e8e93;
}

.no-more {
  text-align: center;
  padding: 40rpx 0;
  font-size: 26rpx;
  color: #aeaeb2;
}

.empty-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  gap: 24rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #8e8e93;
}
