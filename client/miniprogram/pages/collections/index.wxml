<view class="page">
  <!-- Loading -->
  <view wx:if="{{loading}}" class="loading-wrap">
    <view class="loading-ring"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <!-- Empty -->
  <view wx:elif="{{isEmpty}}" class="empty-wrap">
    <view class="empty-illustration">📂</view>
    <text class="empty-title">还没有收藏夹</text>
    <text class="empty-tip">创建一个收藏夹，然后去菜谱详情页收藏喜欢的菜谱</text>
    <view class="empty-actions">
      <view class="empty-action primary" bindtap="onAddCollection">+ 新建收藏夹</view>
      <view class="empty-action secondary" bindtap="onGoExplore">去看看菜谱</view>
    </view>
  </view>

  <!-- Content -->
  <block wx:else>
    <view class="header-bar">
      <view class="header-left">
        <text class="header-title">我的收藏夹</text>
        <text class="header-sub">共 {{collections.length}} 个</text>
      </view>
      <view class="header-action" bindtap="onAddCollection">
        <text class="header-action-icon">+</text>
        <text>新建</text>
      </view>
    </view>

    <scroll-view
      class="grid-scroll"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      bounces="{{true}}"
      refresher-enabled="{{true}}"
      bindrefresherrefresh="loadCollections"
    >
      <view wx:if="{{error}}" class="offline-tip">
        <text>当前处于离线模式，仅显示缓存数据</text>
      </view>

      <view class="grid-container">
        <view
          wx:for="{{collections}}"
          wx:key="id"
          class="grid-cell"
        >
          <view
            class="grid-card"
            bindtap="onItemTap"
            bindlongpress="onCollectionLongPress"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            data-isdefault="{{item.isDefault}}"
          >
            <view class="card-cover">
              <image
                class="cover-img"
                src="{{item.coverImage || (item.recipes && item.recipes[0] && item.recipes[0].coverImage) || ''}}"
                mode="aspectFill"
                binderror="onCoverError"
              />
              <view wx:if="{{!item.coverImage && (!item.recipes || !item.recipes[0] || !item.recipes[0].coverImage)}}" class="cover-fallback">
                <text class="cover-fallback-icon">{{item.isDefault ? '⭐' : '📁'}}</text>
              </view>
              <view class="cover-badge">
                <text class="badge-num">{{item.itemCount || (item.recipes && item.recipes.length) || 0}}</text>
                <text class="badge-label">道</text>
              </view>
            </view>
            <view class="card-body">
              <text class="card-name">{{item.name || '未命名'}}</text>
              <text class="card-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="bottom-safe"></view>
    </scroll-view>
  </block>
</view>
