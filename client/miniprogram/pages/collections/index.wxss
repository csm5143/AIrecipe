.page {
  min-height: 100vh;
  background: #faf7f0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* ========== Loading ========== */
.loading-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
.loading-ring {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid #d4b896;
  border-top-color: transparent;
  border-radius: 50%;
  animation: spin 0.7s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 26rpx;
  color: #b8a590;
}

/* ========== Empty ========== */
.empty-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 60rpx;
  gap: 12rpx;
  text-align: center;
}
.empty-illustration {
  font-size: 96rpx;
  margin-bottom: 8rpx;
  opacity: 0.6;
}
.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3d2b1f;
}
.empty-tip {
  font-size: 26rpx;
  color: #b0a090;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.empty-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}
.empty-action {
  width: 400rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx;
  transition: transform 0.15s;
}
.empty-action:active {
  transform: scale(0.97);
}
.empty-action.primary {
  background: linear-gradient(135deg, #3d2b1f 0%, #5a3e2b 100%);
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(61, 43, 31, 0.18);
}
.empty-action.secondary {
  background: #fff;
  color: #5a3e2b;
  border: 2rpx solid #e0d5c8;
}

/* ========== Header ========== */
.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx 24rpx;
  background: #faf7f0;
}
.header-left {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
}
.header-title {
  font-size: 38rpx;
  font-weight: 800;
  color: #3d2b1f;
  letter-spacing: 0.5rpx;
}
.header-sub {
  font-size: 24rpx;
  color: #b8a590;
}
.header-action {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: #3d2b1f;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  padding: 18rpx 34rpx;
  border-radius: 36rpx;
  box-shadow: 0 4rpx 14rpx rgba(61, 43, 31, 0.12);
}
.header-action:active {
  opacity: 0.85;
}
.header-action-icon {
  font-size: 30rpx;
  margin-right: 2rpx;
}

/* ========== Scroll ========== */
.grid-scroll {
  flex: 1;
}

/* ========== Offline tip ========== */
.offline-tip {
  background: #fef9ec;
  color: #b0782a;
  font-size: 22rpx;
  text-align: center;
  padding: 14rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

/* ========== Grid ========== */
.grid-container {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.grid-cell {
  width: 50%;
  box-sizing: border-box;
  padding: 0 8rpx;
  margin-bottom: 20rpx;
}

/* ========== Card ========== */
.grid-card {
  width: 100%;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.15s;
}
.grid-card:active {
  transform: scale(0.975);
}

/* Cover */
.card-cover {
  position: relative;
  width: 100%;
  height: 220rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f5efe5 0%, #ede4d6 100%);
}
.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.cover-fallback {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-fallback-icon {
  font-size: 64rpx;
  opacity: 0.5;
}

/* Badge */
.cover-badge {
  position: absolute;
  top: 14rpx;
  right: 14rpx;
  display: flex;
  align-items: baseline;
  gap: 2rpx;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8rpx);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.badge-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}
.badge-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-left: 2rpx;
}

/* Body */
.card-body {
  padding: 18rpx 18rpx 20rpx;
}
.card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #3d2b1f;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-bottom: 4rpx;
}
.card-desc {
  display: block;
  font-size: 22rpx;
  color: #b8a590;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* Bottom safe area */
.bottom-safe {
  height: 60rpx;
}
