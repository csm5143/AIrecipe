.page {
  height: 100vh;
  overflow: hidden;
  background: #faf7f0;
}
.page-scroll {
  height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}
.content {
  padding: 24rpx 24rpx 0;
}

/* ========== Card ========== */
.card {
  background: #fff;
  border-radius: 18rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.card-stats {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx 28rpx;
}
.section-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #5a3e2b;
  margin-bottom: 16rpx;
}

/* ========== Cover Row ========== */
.cover-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.cover-left {
  width: 160rpx;
  height: 160rpx;
  border-radius: 14rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f5efe5;
}
.cover-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.cover-empty {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.cover-empty-icon {
  font-size: 56rpx;
  opacity: 0.45;
}
.cover-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  padding: 36rpx 0;
  background: #faf7f0;
  border: 2rpx solid #ede4d6;
  border-radius: 14rpx;
  transition: all 0.15s;
}
.cover-right:active {
  background: #f5efe5;
  border-color: #c9a87c;
}
.cover-action-text {
  font-size: 26rpx;
  font-weight: 600;
  color: #5a3e2b;
}
.cover-action-sub {
  font-size: 20rpx;
  color: #b8a590;
}

/* ========== Fields ========== */
.field {
  margin-bottom: 24rpx;
}
.field-last {
  margin-bottom: 0;
}
.field-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 10rpx;
}
.field-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #5a3e2b;
}
.field-optional {
  font-size: 24rpx;
  font-weight: 400;
  color: #b8a590;
  margin-left: 4rpx;
}
.field-count {
  font-size: 22rpx;
  color: #b8a590;
  flex-shrink: 0;
}
.field-input {
  width: 100%;
  height: 84rpx;
  background: #faf7f0;
  border: 1rpx solid #ede4d6;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #3d2b1f;
  box-sizing: border-box;
}
.field-textarea {
  width: 100%;
  min-height: 140rpx;
  background: #faf7f0;
  border: 1rpx solid #ede4d6;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  color: #3d2b1f;
  box-sizing: border-box;
  line-height: 1.6;
}
.field-error {
  display: block;
  font-size: 22rpx;
  color: #e0483b;
  margin-top: 8rpx;
}

/* ========== Stats ========== */
.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.stat-num {
  font-size: 34rpx;
  font-weight: 700;
  color: #E2A650;
}
.stat-label {
  font-size: 22rpx;
  color: #b8a590;
}
.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background: #ede4d6;
  flex-shrink: 0;
}

/* ========== Actions ========== */
.actions {
  margin-top: 28rpx;
}
.btn-save {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #d4c8b8;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 46rpx;
  letter-spacing: 0.5rpx;
  box-sizing: border-box;
  transition: all 0.15s;
}
.btn-save.active {
  background: linear-gradient(135deg, #E2A650 0%, #d4953a 100%);
  box-shadow: 0 6rpx 20rpx rgba(226,166,80,0.25);
}
.btn-save:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.btn-delete {
  width: 100%;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  background: #fff;
  color: #e0483b;
  font-size: 28rpx;
  font-weight: 600;
  border: 2rpx solid #f5d8d4;
  border-radius: 46rpx;
  box-sizing: border-box;
}
.btn-delete:active {
  background: #fff5f5;
  border-color: #e0483b;
}

/* ========== Safe Bottom ========== */
.bottom-safe {
  height: 80rpx;
}
