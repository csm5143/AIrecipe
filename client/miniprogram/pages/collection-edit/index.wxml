<!-- 收藏夹编辑页 -->
<view class="page">
  <scroll-view class="page-scroll" scroll-y enhanced bounces="{{true}}" show-scrollbar="{{false}}">
    <view class="content">

      <!-- ========== 封面 ========== -->
      <view class="card">
        <text class="section-label">封面图片</text>
        <view class="cover-row" bindtap="onChangeCover">
          <view class="cover-left">
            <image
              wx:if="{{coverImage}}"
              class="cover-img"
              src="{{coverImage}}"
              mode="aspectFill"
            />
            <view wx:else class="cover-empty">
              <text class="cover-empty-icon">🖼️</text>
            </view>
          </view>
          <view class="cover-right">
            <text class="cover-action-text">{{coverImage ? '更换封面' : '点击选择封面'}}</text>
            <text class="cover-action-sub">支持 JPG / PNG</text>
          </view>
        </view>
      </view>

      <!-- ========== 表单 ========== -->
      <view class="card">
        <view class="field">
          <view class="field-header">
            <text class="field-label">收藏夹名称</text>
            <text class="field-count">{{nameLength}}/20</text>
          </view>
          <input
            class="field-input"
            value="{{nameValue}}"
            placeholder="给你的收藏夹起个名字"
            maxlength="20"
            bindinput="onNameInput"
          />
          <text class="field-error" wx:if="{{nameLength >= 20}}">已达到字数上限</text>
        </view>

        <view class="field field-last">
          <view class="field-header">
            <text class="field-label">简介<text class="field-optional">（选填）</text></text>
            <text class="field-count">{{descLength}}/50</text>
          </view>
          <textarea
            class="field-textarea"
            value="{{descValue}}"
            placeholder="简单介绍一下这个收藏夹吧～"
            maxlength="50"
            auto-height
            bindinput="onDescInput"
          />
        </view>
      </view>

      <!-- ========== 统计 ========== -->
      <view class="card card-stats">
        <view class="stat-item">
          <text class="stat-num">{{recipeCount}}</text>
          <text class="stat-label">道菜谱</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{createdDate || '-'}}</text>
          <text class="stat-label">创建时间</text>
        </view>
      </view>

      <!-- ========== 操作按钮 ========== -->
      <view class="actions">
        <view
          class="btn-save {{hasChanges ? 'active' : ''}}"
          bindtap="onSave"
        >
          <text wx:if="{{!saving}}">保存修改</text>
          <text wx:else>保存中...</text>
        </view>

        <view
          wx:if="{{!isDefault}}"
          class="btn-delete"
          bindtap="onDelete"
        >
          <text>删除收藏夹</text>
        </view>
      </view>

      <view class="bottom-safe"></view>
    </view>
  </scroll-view>
</view>
