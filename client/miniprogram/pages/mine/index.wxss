/* ================================================
   我的页面 - 暖米色主题 (Warm Cream)
   ================================================ */

.mine-page {
  height: 100vh;
  overflow: hidden;
  background: var(--app-bg, #fbf4e6);
}

.mine-scroll {
  height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.mine-content {
  padding: 28rpx 28rpx 140rpx;
  padding-bottom: calc(140rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* ================================================
   用户信息卡片
   ================================================ */
.profile-card {
  display: flex;
  align-items: center;
  background: var(--surface, #fffdf8);
  border: 1rpx solid var(--border, rgba(90, 60, 30, 0.1));
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 28rpx;
  box-shadow: var(--shadow, 0 14rpx 34rpx rgba(125, 90, 50, 0.1));
}

.profile-avatar {
  position: relative;
  width: 112rpx;
  height: 112rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.profile-avatar-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary, #e2a650);
}

.profile-avatar-badge {
  position: absolute;
  right: 2rpx;
  bottom: 2rpx;
  width: 36rpx;
  height: 36rpx;
  background: var(--primary, #e2a650);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 10rpx rgba(226, 166, 80, 0.3);
}

.profile-avatar-badge image {
  width: 18rpx;
  height: 18rpx;
}

/* 未登录遮罩 */
.profile-avatar-unlogin {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.profile-unlogin-icon {
  font-size: 52rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* 用户信息文字 */
.profile-info {
  flex: 1;
  min-width: 0;
}

.profile-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-strong, #2d241b);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-desc {
  font-size: 24rpx;
  color: var(--muted, #7a6a58);
}

.profile-arrow {
  font-size: 40rpx;
  color: var(--muted, #7a6a58);
  opacity: 0.4;
  font-weight: 300;
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* ================================================
   功能菜单卡片
   ================================================ */
.menu-card {
  background: var(--surface, #fffdf8);
  border: 1rpx solid var(--border, rgba(90, 60, 30, 0.1));
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow, 0 14rpx 34rpx rgba(125, 90, 50, 0.1));
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  border-bottom: 1rpx solid var(--border, rgba(90, 60, 30, 0.08));
  transition: background-color 0.15s;
}

.menu-item--last {
  border-bottom: none;
}

.menu-item--hover {
  background: var(--surface-2, #f6e8d6);
}

.menu-item-icon {
  width: 48rpx;
  height: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-item-icon image {
  width: 100%;
  height: 100%;
}

.menu-item-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text, #4a3b2a);
  font-weight: 500;
}

.menu-item-arrow {
  font-size: 36rpx;
  color: var(--muted, #7a6a58);
  opacity: 0.35;
  font-weight: 300;
  flex-shrink: 0;
}

.menu-item-badge {
  background: var(--primary, #e2a650);
  color: #fff;
  font-size: 22rpx;
  min-width: 36rpx;
  height: 36rpx;
  padding: 0 10rpx;
  border-radius: 18rpx;
  margin-right: 12rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-item-dot {
  width: 14rpx;
  height: 14rpx;
  background: var(--accent, #d46a4c);
  border-radius: 50%;
  margin-right: 12rpx;
}
