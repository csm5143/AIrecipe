<view class="mine-page">
  <scroll-view class="mine-scroll" scroll-y enhanced bounces="{{true}}">
    <view class="mine-content">

      <!-- 用户信息卡片 -->
      <view class="profile-card">
        <view class="profile-avatar" bindtap="{{hasLogin ? 'onChangeAvatar' : 'onGoToLogin'}}">
          <image class="profile-avatar-img" src="{{userInfo.avatar || '/assets/默认头像.png'}}" mode="aspectFill" />
          <view wx:if="{{hasLogin}}" class="profile-avatar-badge">
            <image src="/assets/相机2.png" mode="aspectFit" />
          </view>
          <view wx:else class="profile-avatar-unlogin">
            <text class="profile-unlogin-icon">+</text>
          </view>
        </view>
        <view class="profile-info" bindtap="onGoToProfile">
          <view class="profile-name">{{hasLogin ? userInfo.nickname : '点击登录'}}</view>
          <view class="profile-desc">{{hasLogin ? '查看并编辑个人资料' : '登录后享受更多功能'}}</view>
        </view>
        <view class="profile-arrow" bindtap="onGoToProfile">›</view>
      </view>

      <!-- 功能菜单 -->
      <view class="menu-card">
        <view class="menu-item" bindtap="onGoToFridge" hover-class="menu-item--hover">
          <view class="menu-item-icon">
            <image src="/assets/冰柜.png" mode="aspectFit" />
          </view>
          <text class="menu-item-text">小冰箱</text>
          <view class="menu-item-badge" wx:if="{{fridgeItemCount > 0}}">{{fridgeItemCount}}</view>
          <text class="menu-item-arrow">›</text>
        </view>

        <view class="menu-item" bindtap="onGoToBasket" hover-class="menu-item--hover">
          <view class="menu-item-icon">
            <image src="/assets/菜篮.png" mode="aspectFit" />
          </view>
          <text class="menu-item-text">小菜篮</text>
          <text class="menu-item-arrow">›</text>
        </view>

        <view class="menu-item" bindtap="onGoToFavorites" hover-class="menu-item--hover">
          <view class="menu-item-icon">
            <image src="/assets/收藏.png" mode="aspectFit" />
          </view>
          <text class="menu-item-text">我的收藏</text>
          <view class="menu-item-badge" wx:if="{{favoriteCount > 0}}">{{favoriteCount}}</view>
          <text class="menu-item-arrow">›</text>
        </view>

        <view class="menu-item" bindtap="onGoToPreference" hover-class="menu-item--hover">
          <view class="menu-item-icon">
            <image src="/assets/偏好.png" mode="aspectFit" />
          </view>
          <text class="menu-item-text">饮食偏好</text>
          <view wx:if="{{preferenceCount > 0}}" class="menu-item-dot"></view>
          <text class="menu-item-arrow">›</text>
        </view>

        <view class="menu-item" bindtap="onFeedback" hover-class="menu-item--hover">
          <view class="menu-item-icon">
            <image src="/assets/反馈.png" mode="aspectFit" />
          </view>
          <text class="menu-item-text">问题反馈</text>
          <text class="menu-item-arrow">›</text>
        </view>

        <view class="menu-item menu-item--last" bindtap="onAbout" hover-class="menu-item--hover">
          <view class="menu-item-icon">
            <image src="/assets/关于我们.png" mode="aspectFit" />
          </view>
          <text class="menu-item-text">关于我们</text>
          <text class="menu-item-arrow">›</text>
        </view>
      </view>

    </view>
  </scroll-view>
</view>
