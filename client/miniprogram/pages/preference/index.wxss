/* ================================================
   偏好设置页面样式 - Warm Minimalism
   ================================================ */

.page {
  min-height: 100vh;
  background-color: var(--app-bg, #fbf4e6);
}

/* 头部 */
.header {
  background: #ffffff;
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.header-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #374151;
  letter-spacing: -0.5px;
  margin-bottom: 12rpx;
}

.header-desc {
  font-size: 26rpx;
  color: #9ca3af;
  line-height: 1.5;
}

/* 内容区域 */
.content {
  padding: 24rpx;
}

/* 分类区块 */
.section {
  background: var(--surface, #fffdf8);
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  transition: background-color 0.15s;
}

.section-header:active {
  background-color: var(--surface-2, #f6e8d6);
}

.section-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.section-icon {
  font-size: 40rpx;
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--surface-2, #f6e8d6);
  border-radius: 14rpx;
}

.section-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
  letter-spacing: -0.2px;
}

.section-count {
  font-size: 22rpx;
  color: #9ca3af;
}

.section-arrow {
  font-size: 40rpx;
  color: #d1d5db;
  font-weight: 300;
  transition: transform 0.2s ease;
}

.section.expanded .section-arrow {
  transform: rotate(90deg);
}

/* 内容区域 */
.section-body {
  padding: 0 24rpx 28rpx;
  animation: slideDown 0.2s ease;
}

@keyframes slideDown {
  from {
    opacity: 0;
    transform: translateY(-10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* 标签网格（忌口、口味、食材、菜系） */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background: var(--app-bg, #fbf4e6);
  border-radius: 999rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.tag-item:active {
  opacity: 0.85;
}

.tag-item.selected {
  background: rgba(226, 165, 80, 0.12);
  border-color: #e2a650;
}

.tag-icon {
  font-size: 28rpx;
}

.tag-label {
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.tag-item.selected .tag-label {
  color: #c7862d;
  font-weight: 600;
}

/* 模式卡片网格（饮食模式） */
.mode-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.mode-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 20rpx;
  background: var(--app-bg, #fbf4e6);
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
  text-align: center;
}

.mode-card:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.mode-card.selected {
  background: rgba(226, 165, 80, 0.12);
  border-color: #e2a650;
}

.mode-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.mode-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
  margin-bottom: 6rpx;
}

.mode-card.selected .mode-label {
  color: #c7862d;
}

.mode-desc {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 重置按钮 */
.reset-section {
  padding: 16rpx 0 24rpx;
}

.reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  background: rgba(226, 165, 80, 0.08);
  border-radius: 12rpx;
  border: 1rpx solid rgba(226, 165, 80, 0.2);
  transition: all 0.15s ease;
}

.reset-btn:active {
  background: rgba(226, 165, 80, 0.15);
}

.reset-icon {
  font-size: 32rpx;
  color: #c7862d;
}

.reset-text {
  font-size: 28rpx;
  color: #c7862d;
  font-weight: 500;
}

/* 底部说明 */
.footer-tip {
  padding: 32rpx 0;
  text-align: center;
}

.footer-tip-text {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 已选中项微阴影 */
.tag-item.selected,
.mode-card.selected {
  box-shadow: 0 2rpx 8rpx rgba(226, 165, 80, 0.15);
}
