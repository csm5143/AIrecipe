# ===========================================
# AIRecipe 环境变量配置（示例文件）
# 复制为 .env 或 server/admin-api/env 并填入真实值
# ===========================================

# ==================== 数据库连接字符串 ====================
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/airecipe

# ==================== 应用环境 ====================
NODE_ENV=development
PORT=3000

# ==================== 数据库 (PostgreSQL) ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airecipe
DB_USER=postgres
DB_PASSWORD=YOUR_DB_PASSWORD

# ==================== Redis (可选) ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT 认证 ====================
JWT_SECRET=YOUR_JWT_SECRET_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# ==================== 腾讯云 COS（对象存储） ====================
TENCENT_COS_SECRET_ID=YOUR_TENCENT_SECRET_ID
TENCENT_COS_SECRET_KEY=YOUR_TENCENT_SECRET_KEY
TENCENT_COS_BUCKET=YOUR_BUCKET_NAME
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BASE_URL=https://YOUR_BUCKET.cos.ap-guangzhou.myqcloud.com

# ==================== 微信小程序 ====================
WECHAT_APPID=YOUR_WECHAT_APPID
WECHAT_SECRET=YOUR_WECHAT_SECRET

# ==================== AI 服务 ====================
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DOUBAO_API_KEY=YOUR_DOUBAO_API_KEY
DOUBAO_API_URL=https://ark.cn-beijing.volces.com/api/v3

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:5173,http://localhost:3001
