# ==================== 应用环境 ====================
NODE_ENV=development
PORT=3000

# ==================== 前端开发服务器端口 ====================
ADMIN_WEB_PORT=5173
MOBILE_APP_PORT=5174

# ==================== 数据库 (PostgreSQL) ====================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=airecipe
DB_USER=postgres
DB_PASSWORD=your_password_here
# 完整连接字符串（推荐在 .env 中使用，格式如下）
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/airecipe?schema=public

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379

# ==================== JWT 认证 ====================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ==================== 对象存储 (OSS) ====================
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=airecipe-assets

# ==================== 微信小程序 ====================
WECHAT_APPID=your_wechat_appid
WECHAT_SECRET=your_wechat_secret

# ==================== AI 服务 ====================
OPENAI_API_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1

# ==================== 文件上传 ====================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/gif

# ==================== CORS ====================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ==================== 日志 ====================
LOG_LEVEL=info
LOG_DIR=./logs
